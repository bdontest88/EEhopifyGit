{% doc %}
  @prompt
    Create a recently viewed products section that tracks and displays products that customers have previously viewed on the store. The section should automatically save viewed products to the browser's local storage and display them in a grid layout with product images, titles, and prices. Include customization options for the number of products to show, heading text, and grid columns., Have a checkbox to hide the section when the recently viewed product is empty
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-recently-viewed-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-recently-viewed-{{ ai_gen_id }}.ai-hidden-{{ ai_gen_id }} {
    display: none;
  }

  .ai-recently-viewed-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-recently-viewed-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-recently-viewed-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
  }

  .ai-recently-viewed-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-recently-viewed-product-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease;
  }

  .ai-recently-viewed-product-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-recently-viewed-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: {{ block.settings.image_background }};
    border-radius: {{ block.settings.image_border_radius }}px;
    margin-bottom: 12px;
  }

  .ai-recently-viewed-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-recently-viewed-product-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ai-recently-viewed-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0;
    font-weight: 500;
  }

  .ai-recently-viewed-product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.product_price_color }};
    font-weight: 600;
  }

  .ai-recently-viewed-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: {{ block.settings.empty_text_color }};
    font-size: 16px;
  }

  @media screen and (max-width: 989px) {
    .ai-recently-viewed-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-recently-viewed-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-recently-viewed-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }
  }
{% endstyle %}

<recently-viewed-products-{{ ai_gen_id }}
  class="ai-recently-viewed-{{ ai_gen_id }}"
  data-max-products="{{ block.settings.max_products }}"
  data-hide-when-empty="{{ block.settings.hide_when_empty }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-recently-viewed-container-{{ ai_gen_id }}">
    <div class="ai-recently-viewed-header-{{ ai_gen_id }}">
      <h2 class="ai-recently-viewed-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    </div>
    <div class="ai-recently-viewed-grid-{{ ai_gen_id }}" data-products-container></div>
    <div class="ai-recently-viewed-empty-{{ ai_gen_id }}" data-empty-state style="display: none;">
      {{ block.settings.empty_message }}
    </div>
  </div>
</recently-viewed-products-{{ ai_gen_id }}>

<script>
  (function() {
    class RecentlyViewedProducts{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.storageKey = 'recentlyViewedProducts';
        this.maxProducts = parseInt(this.dataset.maxProducts) || 8;
        this.hideWhenEmpty = this.dataset.hideWhenEmpty === 'true';
        this.productsContainer = this.querySelector('[data-products-container]');
        this.emptyState = this.querySelector('[data-empty-state]');
      }

      connectedCallback() {
        this.trackCurrentProduct();
        this.renderProducts();
      }

      trackCurrentProduct() {
        if (window.location.pathname.includes('/products/')) {
          const productHandle = window.location.pathname.split('/products/')[1].split('?')[0];
          
          if (productHandle) {
            this.saveProductToHistory(productHandle);
          }
        }
      }

      saveProductToHistory(handle) {
        let recentProducts = this.getRecentProducts();
        
        recentProducts = recentProducts.filter(function(h) {
          return h !== handle;
        });
        
        recentProducts.unshift(handle);
        
        if (recentProducts.length > this.maxProducts) {
          recentProducts = recentProducts.slice(0, this.maxProducts);
        }
        
        try {
          localStorage.setItem(this.storageKey, JSON.stringify(recentProducts));
        } catch (e) {
          console.error('Failed to save to localStorage:', e);
        }
      }

      getRecentProducts() {
        try {
          const stored = localStorage.getItem(this.storageKey);
          return stored ? JSON.parse(stored) : [];
        } catch (e) {
          console.error('Failed to read from localStorage:', e);
          return [];
        }
      }

      renderProducts() {
        let recentProducts = this.getRecentProducts();
        
        if (window.location.pathname.includes('/products/')) {
          const currentHandle = window.location.pathname.split('/products/')[1].split('?')[0];
          recentProducts = recentProducts.filter(function(h) {
            return h !== currentHandle;
          });
        }
        
        if (recentProducts.length === 0) {
          this.showEmptyState();
          return;
        }
        
        this.fetchProductData(recentProducts);
      }

      fetchProductData(handles) {
        const self = this;
        const fetchPromises = handles.map(function(handle) {
          return fetch('/products/' + handle + '.js')
            .then(function(response) {
              if (!response.ok) {
                throw new Error('Product not found');
              }
              return response.json();
            })
            .catch(function(error) {
              console.error('Error fetching product:', handle, error);
              return null;
            });
        });

        Promise.all(fetchPromises).then(function(products) {
          const validProducts = products.filter(function(p) {
            return p !== null;
          });
          
          if (validProducts.length === 0) {
            self.showEmptyState();
          } else {
            self.displayProducts(validProducts);
          }
        });
      }

      displayProducts(products) {
        const self = this;
        this.productsContainer.innerHTML = '';
        this.emptyState.style.display = 'none';
        this.classList.remove('ai-hidden-{{ ai_gen_id }}');
        
        products.forEach(function(product) {
          const productCard = self.createProductCard(product);
          self.productsContainer.appendChild(productCard);
        });
      }

      createProductCard(product) {
        const card = document.createElement('a');
        card.href = '/products/' + product.handle;
        card.className = 'ai-recently-viewed-product-{{ ai_gen_id }}';
        
        const imageWrapper = document.createElement('div');
        imageWrapper.className = 'ai-recently-viewed-image-wrapper-{{ ai_gen_id }}';
        
        if (product.featured_image) {
          const img = document.createElement('img');
          img.src = product.featured_image;
          img.alt = product.title;
          img.className = 'ai-recently-viewed-image-{{ ai_gen_id }}';
          img.loading = 'lazy';
          imageWrapper.appendChild(img);
        }
        
        const productInfo = document.createElement('div');
        productInfo.className = 'ai-recently-viewed-product-info-{{ ai_gen_id }}';
        
        const title = document.createElement('h3');
        title.className = 'ai-recently-viewed-product-title-{{ ai_gen_id }}';
        title.textContent = product.title;
        
        const price = document.createElement('div');
        price.className = 'ai-recently-viewed-product-price-{{ ai_gen_id }}';
        price.textContent = this.formatMoney(product.price);
        
        productInfo.appendChild(title);
        productInfo.appendChild(price);
        
        card.appendChild(imageWrapper);
        card.appendChild(productInfo);
        
        return card;
      }

      formatMoney(cents) {
        const amount = cents / 100;
        return 'Rp ' + amount.toLocaleString('id-ID', {
          minimumFractionDigits: 0,
          maximumFractionDigits: 0
        });
      }

      showEmptyState() {
        this.productsContainer.innerHTML = '';
        
        if (this.hideWhenEmpty) {
          this.classList.add('ai-hidden-{{ ai_gen_id }}');
        } else {
          this.emptyState.style.display = 'block';
          this.classList.remove('ai-hidden-{{ ai_gen_id }}');
        }
      }
    }

    customElements.define('recently-viewed-products-{{ ai_gen_id }}', RecentlyViewedProducts{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Recently viewed products",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recently viewed"
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty state message",
      "default": "You haven't viewed any products yet"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum products to track",
      "min": 4,
      "max": 20,
      "step": 2,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "hide_when_empty",
      "label": "Hide section when empty",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns on tablet",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Heading style"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Bottom spacing",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color",
      "default": "#a42325"
    },
    {
      "type": "header",
      "content": "Product card style"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "image_background",
      "label": "Image background",
      "default": "#f5f5f5"
    },
    {
      "type": "range",
      "id": "product_title_size",
      "label": "Title size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "product_title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "product_price_size",
      "label": "Price size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "product_price_color",
      "label": "Price color",
      "default": "#a42325"
    },
    {
      "type": "color",
      "id": "empty_text_color",
      "label": "Empty state text color",
      "default": "#727272"
    }
  ],
  "presets": [
    {
      "name": "Recently viewed products"
    }
  ]
}
{% endschema %}
