            "custom_liquid_qb9jhX": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "{%- comment -%}\n  -------------------------------------------------------\n  PRE-ORDER DATA INJECTOR (GUI VERSION)\n  Injects the hidden input into the cart form via JS\n  so you don't have to edit 'buy-buttons.liquid'.\n  -------------------------------------------------------\n{%- endcomment -%}\n\n{%- assign po_date = product.metafields.custom.pre_order_date.value -%}\n\n{%- if po_date != blank -%}\n  {%- assign current_seconds = 'now' | date: '%s' -%}\n  {%- assign po_seconds = po_date | date: '%s' -%}\n  \n  {%- comment -%} Only run script if date is in the future {%- endcomment -%}\n  {%- if po_seconds > current_seconds -%}\n    <script>\n      document.addEventListener(\"DOMContentLoaded\", function() {\n        // 1. Find the main Add to Cart form\n        const cartForm = document.querySelector('form[action*=\"/cart/add\"]');\n        \n        if (cartForm) {\n          // 2. Check if input already exists (prevent duplicates)\n          if (!cartForm.querySelector('input[name=\"properties[Pre-Order Delivery]\"]')) {\n            \n            // 3. Create the hidden input\n            const input = document.createElement('input');\n            input.type = 'hidden';\n            input.name = 'properties[Pre-Order Delivery]';\n            input.value = '{{ po_date | date: \"%d %b %Y\" }}'; // Format: 20 Dec 2025\n            \n            // 4. Append to form\n            cartForm.appendChild(input);\n            console.log('Pre-Order date injected into cart form.');\n          }\n        }\n      });\n    </script>\n  {%- endif -%}\n{%- endif -%}"
