    "custom_liquid_mQ3MfM": {
      "type": "custom-liquid",
      "name": "JSON LD FAQ home",
      "settings": {
        "custom_liquid": "<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [\n    {\n      \"@type\": \"Question\",\n      \"name\": \"What is EESOME known for?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"EESOME is an Indonesian ready-to-wear brand known for its effortless, contemporary style for women and matching collections for moms and kids. We focus on locally produced, high-quality garments.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Where does EESOME ship to?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"We are based in Jakarta, Indonesia and ship locally via JNE/Tiki. We also frequently ship internationally, with a strong customer base in Singapore and Southeast Asia.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How do I choose the right size for EESOME clothing?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Our sizing is designed for a comfortable, effortless fit. We provide a detailed size chart on every product page measuring bust, waist, and hips in centimeters. For kids, we recommend sizing up if you prefer a looser fit.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"What payment methods does Shopeesome accept?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"We accept major credit cards, and QRIS payments for Indonesian customers.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Can I return or exchange items?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Yes, we accept exchanges for size discrepancies within 3 days of receiving the item, provided the product is unworn and unwashed with tags attached. Please contact our WhatsApp support to initiate an exchange.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Does EESOME have a physical store?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"We primarily operate online at shopeesome.com, but we occasionally participate in pop-up markets and stock select items in partner boutiques across Indonesia and Singapore.\"\n      }\n    }\n  ]\n}\n</script>",
        "color_scheme": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
