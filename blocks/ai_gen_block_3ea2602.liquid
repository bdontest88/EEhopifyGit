{% doc %}
  @prompt
  create an image block that can be toggled for desktop or mobile. if desktop is toggled on, then the image will only
  show on desktop screen sizes and if the mobile toggle is on then the image can only be seen on mobile screen sizes
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-responsive-image-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
    display: block;
  }

  .ai-responsive-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-responsive-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-responsive-image-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-responsive-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
    opacity: 0.3;
  }

  {% if block.settings.show_on_desktop and block.settings.show_on_mobile %}
    .ai-responsive-image-{{ ai_gen_id }} {
      display: block;
    }
  {% elsif block.settings.show_on_desktop %}
    .ai-responsive-image-{{ ai_gen_id }} {
      display: none;
    }
    @media screen and (min-width: 750px) {
      .ai-responsive-image-{{ ai_gen_id }} {
        display: block;
      }
    }
  {% elsif block.settings.show_on_mobile %}
    .ai-responsive-image-{{ ai_gen_id }} {
      display: block;
    }
    @media screen and (min-width: 750px) {
      .ai-responsive-image-{{ ai_gen_id }} {
        display: none;
      }
    }
  {% else %}
    .ai-responsive-image-{{ ai_gen_id }} {
      display: none;
    }
  {% endif %}

  {% if block.settings.alignment == 'center' %}
    .ai-responsive-image-{{ ai_gen_id }} {
      margin: 0 auto;
    }
  {% elsif block.settings.alignment == 'right' %}
    .ai-responsive-image-{{ ai_gen_id }} {
      margin-left: auto;
    }
  {% endif %}

  {% if block.settings.max_width != 100 %}
    .ai-responsive-image-{{ ai_gen_id }} {
      max-width: {{ block.settings.max_width }}%;
    }
  {% endif %}
{% endstyle %}

<div
  class="ai-responsive-image-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-responsive-image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.image %}
      {% if block.settings.link_url %}
        <a href="{{ block.settings.link_url }}">
          <img
            loading="eager"
            src="{{ block.settings.image | image_url: width: 2000 }}"
            alt="{{ block.settings.image.alt | default: block.settings.alt_text | escape }}"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            fetchpriority="high"
          >
        </a>
      {% else %}
        <img
          loading="eager"
          src="{{ block.settings.image | image_url: width: 2000 }}"
          alt="{{ block.settings.image.alt | default: block.settings.alt_text | escape }}"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          fetchpriority="high"
        >
      {% endif %}
    {% else %}
      <div class="ai-responsive-image-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Responsive Image",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Alt text",
      "info": "Describe the image for screen readers. Leave blank to use the image's alt text."
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "Display Settings"
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Image alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Maximum width",
      "default": 100
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Responsive Image"
    }
  ]
}
{% endschema %}
