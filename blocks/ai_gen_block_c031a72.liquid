{% doc %}
  @prompt
  Create a footer section with multiple columns and customizable section headers with navigation links, a newsletter
  signup area with email input and subscribe button, and social media icons. The footer should have a color picker
  background with text and organized link sections. The section should have customizable margin and padding sizes by
  percentages in increments of 1%, copyright text is not needed. Social media section can set the margin left and right,
  in each section, there is a selector that can choose between 1-4, where the particular section will be, each section
  should have its own padding settings, the social media margins settings should move the social media icons from the
  leftmost of column 1 to the rightmost of column 4, social media icons need to have top and down margin to control the
  vertical spacing, social media icons should only have left margins and top margin that allows icon to move the entire
  width and height respectively. Column spacing between columns should be adjustable.
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  footer {
    width: 100% !important;
    max-width: none !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
  }

  .ai-footer-{{ ai_gen_id }} {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    margin-top: {{ section.settings.margin_top }}%;
    margin-bottom: {{ section.settings.margin_bottom }}%;
    padding-top: {{ section.settings.padding_top }}%;
    padding-bottom: {{ section.settings.padding_bottom }}%;
    padding-left: {{ section.settings.padding_left }}%;
    padding-right: {{ section.settings.padding_right }}%;
    position: relative;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
  }

  .ai-footer-container-{{ ai_gen_id }} {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  .ai-footer-top-{{ ai_gen_id }} {
    display: flex;
    gap: {{ section.settings.column_spacing }}px;
    align-items: flex-start;
  }

  .ai-footer-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    flex: {{ block.settings.column_1_width }};
    order: {{ block.settings.column_1_position }};
    padding-top: {{ block.settings.column_1_padding_top }}%;
    padding-bottom: {{ block.settings.column_1_padding_bottom }}%;
    padding-left: {{ block.settings.column_1_padding_left }}%;
    padding-right: {{ block.settings.column_1_padding_right }}%;
    margin-left: {{ block.settings.column_1_margin_left }}px;
    margin-right: {{ block.settings.column_1_margin_right }}px;
  }

  .ai-footer-column-2-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    flex: {{ block.settings.column_2_width }};
    order: {{ block.settings.column_2_position }};
    padding-top: {{ block.settings.column_2_padding_top }}%;
    padding-bottom: {{ block.settings.column_2_padding_bottom }}%;
    padding-left: {{ block.settings.column_2_padding_left }}%;
    padding-right: {{ block.settings.column_2_padding_right }}%;
    margin-left: {{ block.settings.column_2_margin_left }}px;
    margin-right: {{ block.settings.column_2_margin_right }}px;
  }

  .ai-footer-column-3-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    flex: {{ block.settings.column_3_width }};
    order: {{ block.settings.column_3_position }};
    padding-top: {{ block.settings.column_3_padding_top }}%;
    padding-bottom: {{ block.settings.column_3_padding_bottom }}%;
    padding-left: {{ block.settings.column_3_padding_left }}%;
    padding-right: {{ block.settings.column_3_padding_right }}%;
    margin-left: {{ block.settings.column_3_margin_left }}px;
    margin-right: {{ block.settings.column_3_margin_right }}px;
  }

  .ai-footer-column-4-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    flex: {{ block.settings.column_4_width }};
    order: {{ block.settings.column_4_position }};
    padding-top: {{ block.settings.column_4_padding_top }}%;
    padding-bottom: {{ block.settings.column_4_padding_bottom }}%;
    padding-left: {{ block.settings.column_4_padding_left }}%;
    padding-right: {{ block.settings.column_4_padding_right }}%;
    margin-left: {{ block.settings.column_4_margin_left }}px;
    margin-right: {{ block.settings.column_4_margin_right }}px;
  }

  .ai-footer-column-heading-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 600;
    margin-top: 0;
    margin-bottom: 20px;
    color: {{ section.settings.heading_color }};
  }

  .ai-footer-links-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ai-footer-link-{{ ai_gen_id }} {
    color: {{ section.settings.link_color }};
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .ai-footer-link-{{ ai_gen_id }}:hover {
    color: {{ section.settings.link_hover_color }};
  }

  .ai-footer-newsletter-{{ ai_gen_id }} {
    margin-bottom: 20px;
  }

  .ai-footer-newsletter-form-{{ ai_gen_id }} {
    display: flex;
    gap: 10px;
    margin-top: 15px;
  }

  .ai-footer-newsletter-input-{{ ai_gen_id }} {
    flex-grow: 1;
    padding: 12px 15px;
    border: 1px solid {{ section.settings.input_border_color }};
    border-radius: {{ section.settings.input_border_radius }}px;
    background-color: {{ section.settings.input_background_color }};
    color: {{ section.settings.input_text_color }};
  }

  .ai-footer-newsletter-button-{{ ai_gen_id }} {
    padding: 12px 20px;
    background-color: {{ section.settings.button_background_color }};
    color: {{ section.settings.button_text_color }};
    border: none;
    border-radius: {{ section.settings.button_border_radius }}px;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .ai-footer-newsletter-button-{{ ai_gen_id }}:hover {
    background-color: {{ section.settings.button_hover_background_color }};
  }

  .ai-footer-social-{{ ai_gen_id }} {
    position: absolute;
    top: {{ section.settings.social_margin_top }}%;
    left: {{ section.settings.social_margin_left }}%;
    display: flex;
    gap: 15px;
    z-index: 10;
  }

  .ai-footer-social-link-{{ ai_gen_id }} {
    color: {{ section.settings.social_icon_color }};
    transition: color 0.2s ease;
  }

  .ai-footer-social-link-{{ ai_gen_id }}:hover {
    color: {{ section.settings.social_icon_hover_color }};
  }

  .ai-footer-social-icon-{{ ai_gen_id }} {
    width: 24px;
    height: 24px;
  }

  @media screen and (max-width: 767px) {
    .ai-footer-top-{{ ai_gen_id }} {
      flex-direction: column;
      gap: {{ section.settings.mobile_column_spacing }}px;
      text-align: {{ section.settings.mobile_text_align }};
    }

    .ai-footer-column-{{ ai_gen_id }},
    .ai-footer-column-2-{{ ai_gen_id }},
    .ai-footer-column-3-{{ ai_gen_id }},
    .ai-footer-column-4-{{ ai_gen_id }} {
      flex: 1;
      order: initial;
      border-bottom: 1px solid {{ section.settings.accordion_border_color }};
      margin-left: 0 !important;
      margin-right: 0 !important;
    }

    .ai-footer-column-heading-{{ ai_gen_id }} {
      cursor: pointer;
      position: relative;
      padding: 15px 0;
      margin-bottom: 0;
      user-select: none;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .ai-footer-column-heading-{{ ai_gen_id }}:after {
      content: '+';
      font-size: 20px;
      font-weight: normal;
      transition: transform 0.3s ease;
    }

    .ai-footer-column-heading-{{ ai_gen_id }}.active:after {
      content: '−';
      transform: rotate(0deg);
    }

    .ai-footer-links-{{ ai_gen_id }} {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
      margin-bottom: 0;
    }

    .ai-footer-links-{{ ai_gen_id }}.active {
      max-height: 500px;
      margin-bottom: 20px;
    }

    .ai-footer-newsletter-{{ ai_gen_id }} {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
      margin-bottom: 0;
    }

    .ai-footer-newsletter-{{ ai_gen_id }}.active {
      max-height: 300px;
      margin-bottom: 20px;
    }

    .ai-footer-newsletter-form-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-footer-social-{{ ai_gen_id }} {
      position: relative;
      top: auto;
      left: auto;
      margin-top: 30px;
      {% if section.settings.mobile_text_align == 'center' %}
        justify-content: center;
      {% elsif section.settings.mobile_text_align == 'right' %}
        justify-content: flex-end;
      {% else %}
        justify-content: flex-start;
      {% endif %}
    }

    {% unless section.settings.mobile_accordion_default_open %}
    .ai-footer-links-{{ ai_gen_id }},
    .ai-footer-newsletter-{{ ai_gen_id }} {
      max-height: 0;
    }
    {% endunless %}

    {% if section.settings.mobile_accordion_default_open %}
    .ai-footer-links-{{ ai_gen_id }},
    .ai-footer-newsletter-{{ ai_gen_id }} {
      max-height: 500px;
      margin-bottom: 20px;
    }
    .ai-footer-column-heading-{{ ai_gen_id }}:after {
      content: '−';
    }
    {% endif %}
  }
{% endstyle %}

<footer class="ai-footer-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-footer-container-{{ ai_gen_id }}">
    <div class="ai-footer-top-{{ ai_gen_id }}">
      {% if block.settings.show_column_1 %}
        <div class="ai-footer-column-{{ ai_gen_id }}">
          <h3 class="ai-footer-column-heading-{{ ai_gen_id }}">{{ block.settings.column_1_heading }}</h3>
          <ul class="ai-footer-links-{{ ai_gen_id }}">
            {% if block.settings.menu_1 != blank %}
              {% for link in block.settings.menu_1.links %}
                <li>
                  <a href="{{ link.url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ link.title }}</a>
                </li>
              {% endfor %}
            {% endif %}
          </ul>
        </div>
      {% endif %}

      {% if block.settings.show_column_2 %}
        <div class="ai-footer-column-2-{{ ai_gen_id }}">
          <h3 class="ai-footer-column-heading-{{ ai_gen_id }}">{{ block.settings.column_2_heading }}</h3>
          <ul class="ai-footer-links-{{ ai_gen_id }}">
            {% if block.settings.menu_2 != blank %}
              {% for link in block.settings.menu_2.links %}
                <li>
                  <a href="{{ link.url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ link.title }}</a>
                </li>
              {% endfor %}
            {% endif %}
          </ul>
        </div>
      {% endif %}

      {% if block.settings.show_column_3 %}
        <div class="ai-footer-column-3-{{ ai_gen_id }}">
          <h3 class="ai-footer-column-heading-{{ ai_gen_id }}">{{ block.settings.column_3_heading }}</h3>
          <ul class="ai-footer-links-{{ ai_gen_id }}">
            {% if block.settings.menu_3 != blank %}
              {% for link in block.settings.menu_3.links %}
                <li>
                  <a href="{{ link.url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ link.title }}</a>
                </li>
              {% endfor %}
            {% endif %}
          </ul>
        </div>
      {% endif %}

      {% if block.settings.show_newsletter %}
        <div class="ai-footer-column-4-{{ ai_gen_id }}">
          <h3 class="ai-footer-column-heading-{{ ai_gen_id }}">{{ block.settings.newsletter_heading }}</h3>
          <div class="ai-footer-newsletter-{{ ai_gen_id }}">
            <p>{{ block.settings.newsletter_text }}</p>
            {% form 'customer' %}
              <div class="ai-footer-newsletter-form-{{ ai_gen_id }}">
                <input
                  type="email"
                  name="contact[email]"
                  class="ai-footer-newsletter-input-{{ ai_gen_id }}"
                  placeholder="{{ block.settings.newsletter_placeholder }}"
                  required
                >
                <button
                  type="submit"
                  class="ai-footer-newsletter-button-{{ ai_gen_id }}"
                  name="subscribe"
                >
                  {{ block.settings.newsletter_button_text }}
                </button>
              </div>
            {% endform %}
          </div>
        </div>
      {% endif %}
    </div>

    {% if block.settings.show_social_icons %}
      <div class="ai-footer-social-{{ ai_gen_id }}">
        {% if block.settings.social_facebook_link != blank %}
          <a
            href="{{ block.settings.social_facebook_link }}"
            class="ai-footer-social-link-{{ ai_gen_id }}"
            aria-label="Facebook"
          >
            <svg class="ai-footer-social-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.77,7.46H14.5v-1.9c0-.9.6-1.1,1-1.1h3V.5L14.17.5C10.24.5,9.5,3.44,9.5,5.32v2.15h-3v4h3v12h5v-12h3.85l.42-4Z"/>
            </svg>
          </a>
        {% endif %}

        {% if block.settings.social_twitter_link != blank %}
          <a
            href="{{ block.settings.social_twitter_link }}"
            class="ai-footer-social-link-{{ ai_gen_id }}"
            aria-label="Twitter"
          >
            <svg class="ai-footer-social-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="currentColor">
              <path d="M23.954 4.569c-.885.389-1.83.654-2.825.775 1.014-.611 1.794-1.574 2.163-2.723-.951.555-2.005.959-3.127 1.184-.896-.959-2.173-1.559-3.591-1.559-2.717 0-4.92 2.203-4.92 4.917 0 .39.045.765.127 1.124C7.691 8.094 4.066 6.13 1.64 3.161c-.427.722-.666 1.561-.666 2.475 0 1.71.87 3.213 2.188 4.096-.807-.026-1.566-.248-2.228-.616v.061c0 2.385 1.693 4.374 3.946 4.827-.413.111-.849.171-1.296.171-.314 0-.615-.03-.916-.086.631 1.953 2.445 3.377 4.604 3.417-1.68 1.319-3.809 2.105-6.102 2.105-.39 0-.779-.023-1.17-.067 2.189 1.394 4.768 2.209 7.557 2.209 9.054 0 14-7.503 14-14 0-.21-.005-.418-.015-.628.961-.689 1.8-1.56 2.46-2.548l-.047-.02z"/>
            </svg>
          </a>
        {% endif %}

        {% if block.settings.social_instagram_link != blank %}
          <a
            href="{{ block.settings.social_instagram_link }}"
            class="ai-footer-social-link-{{ ai_gen_id }}"
            aria-label="Instagram"
          >
            <svg class="ai-footer-social-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        {% endif %}

        {% if block.settings.social_pinterest_link != blank %}
          <a
            href="{{ block.settings.social_pinterest_link }}"
            class="ai-footer-social-link-{{ ai_gen_id }}"
            aria-label="Pinterest"
          >
            <svg class="ai-footer-social-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026L12.017 0z"/>
            </svg>
          </a>
        {% endif %}

        {% if block.settings.social_youtube_link != blank %}
          <a
            href="{{ block.settings.social_youtube_link }}"
            class="ai-footer-social-link-{{ ai_gen_id }}"
            aria-label="YouTube"
          >
            <svg class="ai-footer-social-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="currentColor">
              <path d="M23.495 6.205a3.007 3.007 0 0 0-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 0 0 .527 6.205a31.247 31.247 0 0 0-.522 5.805 31.247 31.247 0 0 0 .522 5.783 3.007 3.007 0 0 0 2.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 0 0 2.088-2.088 31.247 31.247 0 0 0 .5-5.783 31.247 31.247 0 0 0-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/>
            </svg>
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {

      if (window.innerWidth <= 767) {
        const footerHeadings = document.querySelectorAll('.ai-footer-{{ ai_gen_id }} .ai-footer-column-heading-{{ ai_gen_id }}');

        // Set initial state based on default open setting
        {% if block.settings.mobile_accordion_default_open %}
        footerHeadings.forEach(heading => {
          heading.classList.add('active');
          const content = heading.nextElementSibling;
          if (content) {
            content.classList.add('active');
          }
        });
        {% endif %}

        footerHeadings.forEach(heading => {
          heading.addEventListener('click', function() {
            const content = this.nextElementSibling;
            const isActive = this.classList.contains('active');

            if (isActive) {
              this.classList.remove('active');
              if (content) {
                content.classList.remove('active');
              }
            } else {
              this.classList.add('active');
              if (content) {
                content.classList.add('active');
              }
            }
          });
        });
      }
    });

    // Handle window resize
    window.addEventListener('resize', function() {
      if (window.innerWidth > 767) {
        const footerHeadings = document.querySelectorAll('.ai-footer-{{ ai_gen_id }} .ai-footer-column-heading-{{ ai_gen_id }}');
        const footerContent = document.querySelectorAll('.ai-footer-{{ ai_gen_id }} .ai-footer-links-{{ ai_gen_id }}, .ai-footer-{{ ai_gen_id }} .ai-footer-newsletter-{{ ai_gen_id }}');

        footerHeadings.forEach(heading => {
          heading.classList.remove('active');
        });

        footerContent.forEach(content => {
          content.classList.remove('active');
        });
      }
    });
  </script>
</footer>

{% schema %}
{
  "name": "Custom Footer",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "column_count",
      "label": "Number of columns",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "4"
    },
    {
      "type": "range",
      "id": "column_spacing",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Column spacing (desktop)",
      "default": 30
    },
    {
      "type": "range",
      "id": "mobile_column_spacing",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Column spacing (mobile)",
      "default": 40
    },{
      "type": "header",
      "content": "Mobile Settings"
    },
    {
      "type": "checkbox",
      "id": "mobile_accordion_default_open",
      "label": "Default accordion sections open on mobile",
      "default": false
    },
    {
      "type": "select",
      "id": "mobile_text_align",
      "label": "Mobile text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "accordion_border_color",
      "label": "Accordion border color (mobile)",
      "default": "#e6e6e6"
    },
    {
      "type": "header",
      "content": "Footer Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "%",
      "label": "Margin top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "%",
      "label": "Margin bottom",
      "default": 0
    },
