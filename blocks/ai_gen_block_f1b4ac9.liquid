{% comment %}
  Shopify Section Block: Announcement Bar with Location Awareness (Liquid Localization)

  This block extends the existing announcement bar functionality by adding
  geographic location detection based on Shopify's native `localization.country` object.
  It can be added to any Shopify section (e.g., your header section).

  Features:
  - Configurable marquee text with speed control and endless loop.
  - Background and text color pickers.
  - Shopify font and font size selection.
  - Inline rich text editor for announcement content.
  - Text repetition control (when endless loop is off).
  - Conditional display based on the currently selected country in the Shopify theme's
    localization settings, or global visibility.
{% endcomment %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% comment %}
  Determine if the announcement bar should be displayed based on location settings.
  - If 'show_globally' is checked, it always shows.
  - Otherwise, it shows only if the currently localized country matches the block's configured country.
{% endcomment %}
{% liquid
  assign should_show_bar = false
  assign configured_country_code_upper = block.settings.country_code | upcase
  if block.settings.show_globally
    assign should_show_bar = true
  elsif localization.country.iso_code and localization.country.iso_code == configured_country_code_upper
    assign should_show_bar = true
  endif
%}

{% style %}
  .ai-announcement-bar-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.font_family.family }}, {{ block.settings.font_family.fallback_families }};
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_family.weight }};
    font-style: {{ block.settings.font_family.style }};
    overflow: hidden;
    white-space: nowrap;
    width: 100%;
    position: relative;
    /* No initial display: none; here, as Liquid will control it inline */
  }

  .ai-announcement-bar__content-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 0;
    {% if block.settings.enable_marquee %}
      {% if block.settings.endless_loop %}
        animation: ai-marquee-endless-{{ ai_gen_id }} {{ block.settings.marquee_speed }}s linear infinite;
      {% else %}
        animation: ai-marquee-{{ ai_gen_id }} {{ block.settings.marquee_speed }}s linear infinite;
      {% endif %}
    {% else %}
      text-align: center;
      width: 100%;
      padding-left: 20px;
      padding-right: 20px;
    {% endif %}
  }

  .ai-announcement-bar__text-{{ ai_gen_id }} {
    display: inline-block;
    {% if block.settings.enable_marquee %}
      margin-right: 100px;
    {% endif %}
  }

  {% if block.settings.enable_marquee %}
    {% if block.settings.endless_loop %}
      .ai-announcement-bar__content-{{ ai_gen_id }} {
        display: flex;
        animation: ai-marquee-endless-{{ ai_gen_id }} {{ block.settings.marquee_speed }}s linear infinite;
      }

      .ai-announcement-bar__endless-wrapper-{{ ai_gen_id }} {
        display: flex;
        flex-shrink: 0;
      }

      @keyframes ai-marquee-endless-{{ ai_gen_id }} {
        0% {
          transform: translateX(0);
        }
        100% {
          transform: translateX(-100%);
        }
      }
    {% else %}
      @keyframes ai-marquee-{{ ai_gen_id }} {
        0% {
          transform: translateX(100%);
        }
        100% {
          transform: translateX(-100%);
        }
      }
    {% endif %}

    .ai-announcement-bar-{{ ai_gen_id }}:hover .ai-announcement-bar__content-{{ ai_gen_id }} {
      animation-play-state: paused;
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    .ai-announcement-bar-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

{% comment %}
  Render the announcement bar only if 'should_show_bar' is true.
  Otherwise, it will not be rendered at all in the HTML.
{% endcomment %}
{% if should_show_bar %}
  <announcement-bar-{{ ai_gen_id }}
    class="ai-announcement-bar-{{ ai_gen_id }}"
    {{ block.shopify_attributes }}
  >
    <div class="ai-announcement-bar__content-{{ ai_gen_id }}">
      {% if block.settings.enable_marquee and block.settings.endless_loop %}
        <div class="ai-announcement-bar__endless-wrapper-{{ ai_gen_id }}">
          {% for i in (1..50) %}
            <span class="ai-announcement-bar__text-{{ ai_gen_id }}">
              {{ block.settings.announcement_text }}
            </span>
          {% endfor %}
        </div>
        <div class="ai-announcement-bar__endless-wrapper-{{ ai_gen_id }}">
          {% for i in (1..50) %}
            <span class="ai-announcement-bar__text-{{ ai_gen_id }}">
              {{ block.settings.announcement_text }}
            </span>
          {% endfor %}
        </div>
      {% else %}
        {% for i in (1..block.settings.text_repetitions) %}
          <span class="ai-announcement-bar__text-{{ ai_gen_id }}">
            {{ block.settings.announcement_text }}
          </span>
        {% endfor %}
      {% endif %}
    </div>
  </announcement-bar-{{ ai_gen_id }}>
{% endif %}

{% comment %}
  The custom element class (AnnouncementBar{{ ai_gen_id }}) is still needed
  for accessibility attributes and potentially other non-visibility related JavaScript
  if you add any later, but the visibility logic is handled by Liquid now.
{% endcomment %}
<script>
  (function() {
    class AnnouncementBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        // No location-based visibility logic here anymore
      }

      connectedCallback() {
        this.setupAccessibility();
      }

      setupAccessibility() {
        const content = this.querySelector('.ai-announcement-bar__content-{{ ai_gen_id }}');
        if (content) {
          content.setAttribute('role', 'banner');
          content.setAttribute('aria-live', 'polite');
        }
      }
    }

    if (!customElements.get('announcement-bar-{{ ai_gen_id }}')) {
      customElements.define('announcement-bar-{{ ai_gen_id }}', AnnouncementBar{{ ai_gen_id }});
    }
  })();
</script>

