{% comment %}
  Shopify Section: Location Aware Announcement Bar

  This section allows you to display customizable announcement bars based on
  the visitor's geographic location. You can add multiple announcement blocks,
  each configured to show for a specific country or globally.

  Features:
  - Geolocation detection using a free IP API (ipapi.co).
  - Conditional display of announcement bars based on detected country.
  - Option to show an announcement globally (to all visitors).
  - Uses Shopify's `country_selector` for easy country selection in the theme editor.
  - Styled with basic Tailwind CSS classes for a modern look.
{% endcomment %}

<!-- Basic styling for the announcement bar components. -->
<!-- Display property is initially set to 'none' and controlled by JavaScript. -->
<style>
  .location-announcement-bar {
    display: none; /* Hidden by default, shown by JS if location matches */
  }

  /*
   * Fallback for Tailwind CSS if not already included in the theme.
   * In a real Shopify theme, you would rely on the theme's existing Tailwind setup.
   */
  .p-3 { padding: 0.75rem; }
  .text-center { text-align: center; }
  .bg-indigo-600 { background-color: #4f46e5; }
  .text-white { color: #ffffff; }
  .text-sm { font-size: 0.875rem; line-height: 1.25rem; }
  .rounded-md { border-radius: 0.375rem; }
  .shadow-md { box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06); }
  .mb-4 { margin-bottom: 1rem; }
</style>

<!-- Main wrapper for all announcement bars within this section -->
<div class="location-announcement-wrapper">
  {% comment %}
    Iterate over each 'announcement' block added in the Shopify theme editor.
    Each block represents a distinct announcement bar.
  {% endcomment %}
  {% for block in section.blocks %}
    {% liquid
      assign block_country_code = block.settings.country_code | upcase
      assign announcement_text = block.settings.announcement_text
      assign show_globally = block.settings.show_globally
    %}

    {% comment %}
      Only render the HTML for the announcement bar if there's text content.
    {% endcomment %}
    {% if announcement_text != blank %}
      <div
        class="location-announcement-bar p-3 text-center bg-indigo-600 text-white text-sm rounded-md shadow-md mb-4"
        data-country-code="{{ block_country_code }}"
        {#
        Country
        code
        set
        in
        the
        block
        settings
        #}
        data-show-globally="{{ show_globally }}"
        {#
        Boolean
        for
        global
        display
        #}
        data-block-id="{{ block.id }}"
        {#
        Unique
        ID
        for
        the
        block
        #}
      >
        {{ announcement_text }}
      </div>
    {% endif %}
  {% endfor %}
</div>

{% comment %}
  JavaScript for location detection and conditional display.
  This script fetches the user's country and then shows/hides
  the announcement bars accordingly.
{% endcomment %}
<script>
  // IIFE (Immediately Invoked Function Expression) to encapsulate the script
  // and prevent variables from polluting the global scope.
  (function() {
    // Select all announcement bar elements on the page.
    const announcementBars = document.querySelectorAll('.location-announcement-bar');
    // API endpoint for IP-based geolocation. ipapi.co is used as a free, simple option.
    const ipApiUrl = 'https://ipapi.co/json/';

    /**
     * Fetches the user's country code based on their IP address.
     * @returns {Promise<string|null>} A promise that resolves with the
     * 2-letter country code (e.g., 'US', 'CA')
     * in uppercase, or null if detection fails.
     */
    async function getUserCountry() {
      try {
        const response = await fetch(ipApiUrl);
        // Check if the network request was successful (status 200-299).
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        const data = await response.json();

        // Validate that the response contains a valid country_code.
        if (data && typeof data.country_code === 'string') {
          return data.country_code.toUpperCase(); // Return uppercase 2-letter country code
        }
        console.warn('IP API response did not contain a valid country_code:', data);
        return null; // Return null if country_code is missing or invalid.
      } catch (error) {
        // Log any errors that occur during the fetch operation.
        console.error('Error fetching IP-based location:', error);
        return null; // Return null on any error during fetch or JSON parsing.
      }
    }

    /**
     * Updates the visibility of announcement bars.
     * An announcement bar is shown if:
     * 1. Its 'Show Globally?' setting is checked.
     * 2. OR, if the user's detected country matches the country selected for the block.
     * Otherwise, the announcement bar remains hidden.
     */
    async function updateAnnouncementVisibility() {
      // Get the user's country code asynchronously.
      const userCountryCode = await getUserCountry();

      // Log the detected country for debugging purposes in the browser console.
      console.log('User country detected:', userCountryCode || 'Unknown (failed to detect)');

      // Iterate over each announcement bar element found on the page.
      announcementBars.forEach(bar => {
        // Retrieve settings from data attributes.
        const blockCountryCode = bar.dataset.countryCode;
        // Convert the 'true'/'false' string from dataset to a boolean.
        const showGlobally = bar.dataset.showGlobally === 'true';

        let shouldShow = false; // Flag to determine if the current bar should be visible.

        // Logic to determine visibility:
        if (showGlobally) {
          // If 'Show Globally' is checked, the announcement is always visible.
          shouldShow = true;
        } else if (userCountryCode && userCountryCode === blockCountryCode) {
          // If not global, check if the detected user country matches the block's configured country.
          // Ensure both are valid and match for conditional display.
          shouldShow = true;
        }

        // Apply the display style based on the 'shouldShow' flag.
        if (shouldShow) {
          bar.style.display = 'block'; // Make the announcement visible.
        } else {
          bar.style.display = 'none'; // Hide the announcement.
        }

        // Detailed logging for each block's visibility decision.
        console.log(
          `Block ID: ${bar.dataset.blockId || 'N/A'}, ` +
          `Configured Country: ${blockCountryCode || 'N/A'}, ` +
          `Show Globally: ${showGlobally}, ` +
          `Should Show: ${shouldShow}`
        );
      });
    }

    // Add an event listener to run the visibility update function once the
    // entire DOM content has been loaded and parsed. This ensures all
    // announcement bar elements are available before the script tries to access them.
    document.addEventListener('DOMContentLoaded', updateAnnouncementVisibility);
  })();
</script>

